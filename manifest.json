{
  "manifest_version": 3,
  "key": "",
  "name": "gw-worktime",
  "version": "1.1.0",
  "description": "아마란스 그룹웨어에 들어가지 않고 이번 달 근무시간과 퇴근 가능 시각을 확인하고, 새 알림을 받습니다.",
  "permissions": [
    "cookies",
    "storage",
    "sidePanel",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://gw.goorm.io/*",
    "https://api.github.com/repos/egg-silver/amaranth-worktime-extension/*",
    "https://raw.githubusercontent.com/egg-silver/amaranth-worktime-extension/*"
  ],
  "side_panel": {
    "default_path": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://gw.goorm.io/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "근무시간",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
